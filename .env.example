# Required database connection string
DATABASE_URL=postgres://user:password@localhost:5432/database?sslmode=disable

# HTTP server port (default: 8080)
PORT=8080

# JWT signing secret (default: dev-secret-change-me; set a strong secret outside development)
JWT_SECRET=change-me

# Access token lifetime in minutes (default: 5)
JWT_EXPIRES_MINUTES=5

# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_EXPIRES_DAYS=30

# Set to false only for local development over plain HTTP (default: true)
COOKIE_SECURE=true

# Allowed frontend origin for CORS (default: http://localhost:5173)
CORS_ALLOWED_ORIGIN=http://localhost:5173
